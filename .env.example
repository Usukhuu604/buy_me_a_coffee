# Environment Variables Template for Cloudinary

# Copy this file to .env.local in the client directory
# Replace the values with your actual Cloudinary configuration

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dd7qcdmww
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=coffee-time
NEXT_PUBLIC_CLOUDINARY_FOLDER=coffeeproject

# Note: These are public environment variables (prefixed with NEXT_PUBLIC_)
# because they are used in client-side code. This is safe for upload presets
# configured for unsigned uploads.

# For production, consider implementing server-side uploads for better security